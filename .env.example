# Copy to .env (chmod 600). Never commit .env.
# PayPal sandbox: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled after the webhook is registered (11-03)
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Any long random string. Protects the campaign editor API.
ADMIN_TOKEN=
PORT=8787
# Address phones can reach, for the QR on the giving screen (e.g. the deployed URL)
PUBLIC_URL=
# AI drafts (second-language line, giving assistant). Claude API key from the Claude Console. Leave empty to turn AI off.
# Named CLAUDE_API_KEY on purpose, so it never changes how other Anthropic tools on this machine bill.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Caps so a public demo can't burn the quota
AI_DAILY_LIMIT=300
AI_PER_IP_10MIN=20

# Public demo only: bring back the sample campaign N minutes after a change (0 or empty = off)
DEMO_RESET_MINUTES=
